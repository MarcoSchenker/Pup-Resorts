{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "lib": ["ES2020"],                   
    "strict": true,
    "baseUrl": "./",
    "outDir": "./dist",
    "esModuleInterop": true,                 
    "skipLibCheck": true,                     
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "paths": {
      "@src/*": ["src/*"]
    },
    "useUnknownInCatchVariables": false,
  },
  "ts-node": {
    "swc": true,
    "require": [
      "tsconfig-paths/register"
    ],
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "scripts",
    "eslint.config.ts",
    "vitest.config.mts"
  ],
  "exclude": [
    "src/public/*"
  ]
}
