{
  "name": "pupresorts-back",
  "version": "0.0.0",
  "scripts": {
    "dev": "nodemon --watch src --exec ts-node src/index.ts",
    "build": "tsc && tsc-alias",
    "start": "prisma migrate deploy && node dist/src/index.js",
    "clean": "rimraf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "test": "jest",
    "db:make-migration": "prisma migrate dev",
    "db:seed": "prisma db seed"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.916.0",
    "@aws-sdk/s3-request-presigner": "^3.916.0",
    "@mercadopago/sdk-react": "^1.0.6",
    "@prisma/client": "^6.14.0",
    "@types/cors": "^2.8.19",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-validator": "^7.2.1",
    "fs-extra": "^11.3.1",
    "http-status": "^2.1.0",
    "jet-env": "^1.1.4",
    "jet-logger": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "mercadopago": "^2.9.0",
    "module-alias": "^2.2.3",
    "multer": "^2.0.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@stylistic/eslint-plugin-js": "^4.4.1",
    "@stylistic/eslint-plugin-ts": "^4.4.1",
    "@swc/core": "^1.13.5",
    "@swc/jest": "^0.2.39",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/module-alias": "^2.0.4",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.2.1",
    "cross-env": "^10.0.0",
    "eslint": "^9.33.0",
    "eslint-plugin-n": "^17.21.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.10",
    "prisma": "^6.14.0",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1"
  }
}
